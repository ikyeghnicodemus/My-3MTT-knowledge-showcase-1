generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  artisan   Artisan?
  bookings  Booking[] @relation("CustomerBookings")
}

model Artisan {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @unique
  profession String
  location   String
  experience Int?
  bio        String?
  phone      String?
  photo      String?
  available  Boolean  @default(true)
  skills     String?
  price      Float?
  bookings   Booking[]
}

model Booking {
  id         Int           @id @default(autoincrement())
  artisan    Artisan       @relation(fields: [artisanId], references: [id])
  artisanId  Int
  customer    User         @relation("CustomerBookings", fields: [customerId], references: [id])
  customerId Int
  date       DateTime
  time       String
  description String?
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

enum Role {
  CUSTOMER
  ARTISAN
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}
